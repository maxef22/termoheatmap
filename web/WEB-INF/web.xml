<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">

    <display-name>Termoheatmap — тепловая карта температур</display-name>

    <!--
        Сервлеты объявлены только здесь. Аннотации @WebServlet убраны: двойное
        объявление (аннотация + web.xml) даёт контейнеру повод создать два
        экземпляра класса и делает поведение зависимым от версии Tomcat.
    -->

    <servlet>
        <servlet-name>TreeRootsServlet</servlet-name>
        <servlet-class>com.controlj.addon.temperature.servlet.TreeRootsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TreeRootsServlet</servlet-name>
        <url-pattern>/tree/roots</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SensorFinderServlet</servlet-name>
        <servlet-class>com.controlj.addon.temperature.servlet.SensorFinderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SensorFinderServlet</servlet-name>
        <url-pattern>/sensors/find</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TemperatureDataServlet</servlet-name>
        <servlet-class>com.controlj.addon.temperature.servlet.TemperatureDataServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TemperatureDataServlet</servlet-name>
        <url-pattern>/temperature/data</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>temperature.jsp</welcome-file>
    </welcome-file-list>

</web-app>
